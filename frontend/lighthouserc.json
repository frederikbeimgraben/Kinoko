{
  "ci": {
    "collect": {
      "staticDistDir": "dist/pilzkarte/browser",
      "url": ["http://localhost/index.html"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --enable-unsafe-swiftshader"
      }
    },
    "assert": {
      "assertions": {
        "categories:pwa": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-bericht",
      "reportFilenamePattern": "lighthouse.%%EXTENSION%%"
    }
  }
}
