erDiagram
    combination {
        VARCHAR(36) id PK
        VARCHAR(80) name
        VARCHAR(16) rule
        TEXT factors
        DATETIME created_at
        DATETIME updated_at
        VARCHAR(255) owner_sub FK
    }
    find {
        VARCHAR(36) id PK
        VARCHAR(255) owner_name "optional"
        VARCHAR(64) species_slug
        FLOAT lat
        FLOAT lon
        DATE found_on
        INTEGER count "optional"
        BOOLEAN for_training
        VARCHAR(16) visibility
        TEXT note "optional"
        DATETIME created_at
        DATETIME updated_at
        VARCHAR(255) owner_sub FK
    }
    marker {
        VARCHAR(36) id PK
        VARCHAR(80) name
        FLOAT lat
        FLOAT lon
        VARCHAR(16) color
        VARCHAR(16) visibility
        TEXT note "optional"
        DATETIME created_at
        DATETIME updated_at
        VARCHAR(255) owner_sub FK
    }
    permission {
        VARCHAR(40) key PK
        VARCHAR(20) area
    }
    photo {
        VARCHAR(36) id PK
        VARCHAR(36) find_id FK
        VARCHAR(64) filename
        INTEGER width
        INTEGER height
        DATETIME created_at
    }
    role {
        VARCHAR(36) id PK
        VARCHAR(64) slug UK
        VARCHAR(80) name
        TEXT description "optional"
        BOOLEAN built_in
        DATETIME created_at
        DATETIME updated_at
    }
    role_permission {
        VARCHAR(36) role_id PK, FK
        VARCHAR(40) permission_key PK, FK
    }
    species_image {
        VARCHAR(36) id PK
        VARCHAR(80) species_slug
        VARCHAR(255) uploader_sub FK
        VARCHAR(120) photographer
        VARCHAR(16) licence
        TEXT source "optional"
        DATE taken_on "optional"
        VARCHAR(200) caption "optional"
        FLOAT lat "optional"
        FLOAT lon "optional"
        BOOLEAN lead
        VARCHAR(16) state
        VARCHAR(200) reject_reason "optional"
        VARCHAR(255) reviewed_by FK "optional"
        DATETIME reviewed_at "optional"
        INTEGER width
        INTEGER height
        DATETIME created_at
        DATETIME updated_at
    }
    taxon {
        VARCHAR(36) id PK
        VARCHAR(16) rank
        INTEGER rank_order
        VARCHAR(80) slug UK
        VARCHAR(120) name
        VARCHAR(120) latin_name "optional"
        VARCHAR(36) parent_id FK "optional"
        TEXT description "optional"
    }
    term {
        INTEGER id PK
        VARCHAR(32) kind
        VARCHAR(64) slug
        VARCHAR(120) name
        INTEGER position
    }
    text {
        VARCHAR(120) key PK
        VARCHAR(5) locale PK
        TEXT value
        DATETIME updated_at
        VARCHAR(255) updated_by FK "optional"
    }
    user {
        VARCHAR(255) sub PK
        VARCHAR(255) email "optional"
        VARCHAR(255) name "optional"
        DATETIME created_at
    }
    user_role {
        VARCHAR(255) user_sub PK, FK
        VARCHAR(36) role_id PK, FK
        DATETIME granted_at
    }
    zone {
        VARCHAR(36) id PK
        VARCHAR(80) name
        TEXT polygon
        FLOAT area_ha
        VARCHAR(16) color
        VARCHAR(16) visibility
        TEXT note "optional"
        DATETIME created_at
        DATETIME updated_at
        VARCHAR(255) owner_sub FK
    }
    find ||--o{ photo : "find_id"
    permission ||--o{ role_permission : "permission_key"
    role ||--o{ role_permission : "role_id"
    role ||--o{ user_role : "role_id"
    taxon |o--o{ taxon : "parent_id"
    user |o--o{ species_image : "reviewed_by"
    user |o--o{ text : "updated_by"
    user ||--o{ combination : "owner_sub"
    user ||--o{ find : "owner_sub"
    user ||--o{ marker : "owner_sub"
    user ||--o{ species_image : "uploader_sub"
    user ||--o{ user_role : "user_sub"
    user ||--o{ zone : "owner_sub"
